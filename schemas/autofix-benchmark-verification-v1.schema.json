{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhanghl-learner/docker-ollama-autofix/blob/main/schemas/autofix-benchmark-verification-v1.schema.json",
  "title": "AutoFix Frozen Benchmark Verification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "root", "manifest_path", "manifest_sha256",
    "name", "passed", "cases", "report_path"
  ],
  "properties": {
    "schema": {"const": "autofix-benchmark-verification"},
    "version": {"const": 1},
    "root": {"type": "string", "minLength": 1},
    "manifest_path": {"type": "string", "minLength": 1},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "name": {"type": "string", "minLength": 1},
    "passed": {"type": "boolean"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}},
    "report_path": {"type": ["string", "null"]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "repository", "revision", "license"],
      "properties": {
        "kind": {"enum": ["upstream", "synthetic"]},
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1}
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": [
        "path", "source", "expected_tree_sha256", "actual_tree_sha256",
        "file_count", "size_bytes", "matched"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/source"},
        "expected_tree_sha256": {"$ref": "#/$defs/sha256"},
        "actual_tree_sha256": {"$ref": "#/$defs/sha256"},
        "file_count": {"type": "integer", "minimum": 1},
        "size_bytes": {"type": "integer", "minimum": 1},
        "matched": {"type": "boolean"}
      }
    }
  }
}
