{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhanghl-learner/docker-ollama-autofix/blob/main/schemas/autofix-static-analysis-v1.schema.json",
  "title": "AutoFix Static Analysis v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "root", "analyzers", "available_count",
    "declared_count", "run_requested", "run"
  ],
  "properties": {
    "schema": {"const": "autofix-static-analysis"},
    "version": {"const": 1},
    "root": {"type": "string", "minLength": 1},
    "analyzers": {
      "type": "array",
      "items": {"$ref": "#/$defs/analyzer"}
    },
    "available_count": {"type": "integer", "minimum": 0},
    "declared_count": {"type": "integer", "minimum": 0},
    "run_requested": {"type": "boolean"},
    "run": {"anyOf": [{"$ref": "#/$defs/build"}, {"type": "null"}]}
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "argv"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "analyzer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "language", "markers", "step", "available", "availability"
      ],
      "properties": {
        "name": {"enum": ["ruff", "mypy", "eslint", "clippy"]},
        "language": {"type": "string", "minLength": 1},
        "markers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "step": {"$ref": "#/$defs/step"},
        "available": {"type": "boolean"},
        "availability": {"type": "string", "minLength": 1}
      }
    },
    "step_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label", "argv", "exit_code", "stdout", "stderr",
        "duration_seconds", "timed_out", "succeeded"
      ],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "exit_code": {"type": "integer"},
        "stdout": {"type": "string"},
        "stderr": {"type": "string"},
        "duration_seconds": {"type": "number", "minimum": 0},
        "timed_out": {"type": "boolean"},
        "succeeded": {"type": "boolean"}
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root", "started_at", "succeeded", "exit_code", "steps", "report_path"
      ],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "started_at": {"type": "string"},
        "succeeded": {"type": "boolean"},
        "exit_code": {"type": "integer"},
        "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step_result"}},
        "report_path": {"type": ["string", "null"]}
      }
    }
  }
}
