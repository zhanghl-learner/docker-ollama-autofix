{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhanghl-learner/docker-ollama-autofix/blob/main/schemas/autofix-evaluation-publication-v2.schema.json",
  "title": "AutoFix Evaluation Publication v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "release", "reviewed_at", "reviewed_by",
    "review_note", "accepted_failed_suite", "benchmark",
    "source_suite_sha256", "source_suite_version", "suite_started_at",
    "suite_passed", "autofix_version", "model", "model_identity", "runner",
    "runtime_identity", "max_attempts", "case_set_sha256", "metrics", "cases"
  ],
  "allOf": [
    {
      "if": {"properties": {"runner": {"const": "local"}}},
      "then": {
        "properties": {
          "runtime_identity": {
            "properties": {
              "toolchain_scope": {"const": "host"},
              "container_image": {"type": "null"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"runner": {"const": "docker"}}},
      "then": {
        "properties": {
          "runtime_identity": {
            "properties": {
              "toolchain_scope": {"const": "container"},
              "container_image": {"$ref": "#/$defs/containerImage"}
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schema": {"const": "autofix-evaluation-publication"},
    "version": {"const": 2},
    "release": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "reviewed_by": {"type": "string", "minLength": 1, "maxLength": 200},
    "review_note": {"type": "string", "minLength": 1, "maxLength": 2000},
    "accepted_failed_suite": {"type": "boolean"},
    "benchmark": {"$ref": "#/$defs/benchmark"},
    "source_suite_sha256": {"$ref": "#/$defs/sha256"},
    "source_suite_version": {"enum": [5, 6]},
    "suite_started_at": {"type": "string", "format": "date-time"},
    "suite_passed": {"type": "boolean"},
    "autofix_version": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "model_identity": {"$ref": "#/$defs/modelIdentity"},
    "runner": {"enum": ["local", "docker"]},
    "runtime_identity": {"$ref": "#/$defs/runtimeIdentity"},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 20},
    "case_set_sha256": {"$ref": "#/$defs/sha256"},
    "metrics": {"type": "object", "minProperties": 6},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "repository", "revision", "license"],
      "properties": {
        "kind": {"enum": ["upstream", "synthetic"]},
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1}
      }
    },
    "benchmarkCase": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "source", "tree_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/source"},
        "tree_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "benchmark": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "manifest_sha256", "cases"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/benchmarkCase"}}
      }
    },
    "modelIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "digest", "format", "family", "parameter_size", "quantization_level"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/sha256"},
        "format": {"type": ["string", "null"]},
        "family": {"type": ["string", "null"]},
        "parameter_size": {"type": ["string", "null"]},
        "quantization_level": {"type": ["string", "null"]}
      }
    },
    "toolchain": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "command", "available", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "available": {"const": true},
        "version": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "containerImage": {
      "type": "object", "additionalProperties": false,
      "required": ["reference", "image_id", "repo_digests"],
      "properties": {
        "reference": {"type": "string", "minLength": 1, "maxLength": 500},
        "image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "repo_digests": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "pattern": "^.+@sha256:[0-9a-f]{64}$", "maxLength": 500}
        }
      }
    },
    "runtimeIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["python", "implementation", "system", "release", "machine", "toolchain_scope", "container_image", "toolchains"],
      "properties": {
        "python": {"type": "string", "minLength": 1},
        "implementation": {"type": "string", "minLength": 1},
        "system": {"type": "string", "minLength": 1},
        "release": {"type": "string"},
        "machine": {"type": "string"},
        "toolchain_scope": {"enum": ["host", "container"]},
        "container_image": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/containerImage"}]},
        "toolchains": {"type": "array", "items": {"$ref": "#/$defs/toolchain"}}
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["relative_root", "contract_sha256", "name", "language", "difficulty", "status", "passed", "error_kind"],
      "properties": {
        "relative_root": {"type": "string", "minLength": 1},
        "contract_sha256": {"$ref": "#/$defs/sha256"},
        "name": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 1},
        "difficulty": {"type": "string", "minLength": 1},
        "status": {"enum": ["passed", "failed", "invalid_manifest", "execution_error", "duplicate_case_name"]},
        "passed": {"type": "boolean"},
        "error_kind": {"enum": [null, "invalid_manifest", "execution_error", "duplicate_case_name"]}
      }
    }
  }
}
