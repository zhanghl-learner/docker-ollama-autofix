{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhanghl-learner/docker-ollama-autofix/blob/main/schemas/autofix-property-candidate-v1.schema.json",
  "title": "AutoFix Property Candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "root", "plan_path", "model", "rationale",
    "property", "candidate", "metadata_path", "executed"
  ],
  "properties": {
    "schema": {"const": "autofix-property-candidate"},
    "version": {"const": 1},
    "root": {"type": "string", "minLength": 1},
    "plan_path": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "property": {"type": "string", "minLength": 1},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "sha256", "size_bytes", "framework", "test_functions",
        "target_path"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 65536},
        "framework": {"const": "hypothesis"},
        "test_functions": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "pattern": "^test_"}
        },
        "target_path": {"type": "string", "pattern": "^\\.autofix_property_candidates/"}
      }
    },
    "metadata_path": {"type": "string", "minLength": 1},
    "executed": {"const": false}
  }
}
